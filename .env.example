# ── YouCam API ────────────────────────────────────────────────────────────────
YCE_TOKEN=your_youcam_api_token_here

# ── Backblaze B2 (S3-compatible storage) ───────────────────────────────────────
B2_KEY_ID=your_b2_key_id_here
B2_SECRET_KEY=your_b2_application_key_here
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_BUCKET=your_bucket_name_here

# ── App & Security Settings ──────────────────────────────────────────────────
SECRET_KEY=generate_a_secure_random_string_for_sessions
ADMIN_PASSWORD=create_a_secure_admin_password
DEMO_PASSWORD=create_a_secure_demo_password

# ── Server & Database (Optional) ─────────────────────────────────────────────
PORT=8000
# DATABASE_URL=sqlite:///./styleai.db
